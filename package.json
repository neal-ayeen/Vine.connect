{
  "name": "vine-connect",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vine Solutions private company chat and meetings app",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "node --check server.mjs && node --check server/platform-api.mjs && node --check app.js && node --check sw.js && tsc --noEmit",
    "generate:vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "@vitejs/plugin-react": "6.0.4",
    "compression": "1.8.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2"
  }
}
